{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@feynman/contracts": ["packages/contracts/src/index.ts"],
      "@feynman/scientific-domain": ["packages/scientific-domain/src/index.ts"],
      "@feynman/computation": ["packages/computation/src/index.ts"],
      "@feynman/exploration": ["packages/exploration/src/index.ts"],
      "@feynman/visualization": ["packages/visualization/src/index.ts"],
      "@feynman/design-system": ["packages/design-system/src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  }
}