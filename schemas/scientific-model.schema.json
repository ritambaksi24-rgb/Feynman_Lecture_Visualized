{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feynman-lectures-visualized.org/schemas/scientific-model.schema.json",
  "title": "Scientific Model Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "variables",
    "parameters",
    "assumptions",
    "validityDomain",
    "initialState",
    "invariants",
    "randomness",
    "numericalMethod"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "unit",
          "dimension",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "role": {
            "enum": [
              "state",
              "derived"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "unit",
          "defaultValue",
          "dimension"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "defaultValue": {
            "type": "number"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "dimension": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validityDomain": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "initialState": {
      "type": "object",
      "required": [
        "time",
        "values"
      ],
      "properties": {
        "time": {
          "type": "number"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "additionalProperties": false
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "randomness": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "deterministic",
            "seeded",
            "stochastic"
          ]
        },
        "seed": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "numericalMethod": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}