{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feynman-lectures-visualized.org/schemas/visualization-state.schema.json",
  "title": "Renderer-neutral Visualization State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "visualizationId",
    "version",
    "title",
    "dimensions",
    "series"
  ],
  "properties": {
    "visualizationId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "x",
          "y"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "y": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object"
    }
  }
}