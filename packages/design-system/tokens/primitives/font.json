{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "primitive": {
    "font": {
      "family": {
        "body": {
          "$type": "fontFamily",
          "$value": [
            "Roboto",
            "Arial",
            "sans-serif"
          ]
        },
        "serif": {
          "$type": "fontFamily",
          "$value": [
            "Noto Serif",
            "Times New Roman",
            "serif"
          ]
        },
        "mono": {
          "$type": "fontFamily",
          "$value": [
            "ui-monospace",
            "SFMono-Regular",
            "Consolas",
            "monospace"
          ]
        }
      },
      "weight": {
        "regular": {
          "$type": "fontWeight",
          "$value": 400
        },
        "medium": {
          "$type": "fontWeight",
          "$value": 500
        },
        "semibold": {
          "$type": "fontWeight",
          "$value": 600
        },
        "bold": {
          "$type": "fontWeight",
          "$value": 700
        }
      }
    }
  }
}